---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const puzzles = await getCollection("puzzles");
const logicCount = puzzles.filter((p) => p.data.gameType === "logic-grid").length;
const packets = await getCollection("packets");
const packetCount = packets.length;
const packetGrades = new Set(packets.map((p) => p.data.difficulty)).size;
const mazes = await getCollection("mazes");
const mazeCount = mazes.length;
const mazeGrades = Math.max(...mazes.map((m) => Number(m.data.difficulty.replace(/\D/g, ""))));
const sudokus = await getCollection("sudokus");
const sudokuCount = sudokus.length;
const sudokuGrades = Math.max(...sudokus.map((s) => Number(s.data.difficulty.replace(/\D/g, ""))));
---
<Base title="Marshellis Games">
  <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">Marshellis Games</h1>
  <p class="mt-2 text-slate-500">Pick a game to play or print.</p>

  <ul class="mt-8 grid gap-5 sm:grid-cols-2">
    <li>
      <a href="/logic-grid"
         class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 no-underline shadow-sm transition hover:-translate-y-0.5 hover:border-brand-400 hover:shadow-md">
        <div class="text-4xl">🧩</div>
        <div class="mt-3 text-xl font-bold text-slate-900">Logic Grid Puzzles</div>
        <p class="mt-1 text-sm text-slate-500">Read the clues, fill the grid with X and O, and deduce the one answer.</p>
        <div class="mt-4 flex items-center gap-2 text-xs font-medium text-slate-400">
          <span class="rounded-full bg-slate-100 px-2 py-0.5">{logicCount} puzzles</span>
          <span class="rounded-full bg-slate-100 px-2 py-0.5">Grades 1–8</span>
        </div>
        <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 transition-all group-hover:gap-2">
          Play now <span aria-hidden="true">→</span>
        </span>
      </a>
    </li>

    <li>
      <a href="/math"
         class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 no-underline shadow-sm transition hover:-translate-y-0.5 hover:border-brand-500 hover:shadow-md">
        <div class="text-4xl">🔢</div>
        <div class="mt-3 text-xl font-bold text-slate-900">Math Worksheets</div>
        <p class="mt-1 text-sm text-slate-500">A daily mix of quick number puzzles — circle, fill, and solve. Play on screen or print.</p>
        <div class="mt-4 flex items-center gap-2 text-xs font-medium text-slate-400">
          <span class="rounded-full bg-slate-100 px-2 py-0.5">{packetCount} days</span>
          <span class="rounded-full bg-slate-100 px-2 py-0.5">Grades 1–{packetGrades}</span>
        </div>
        <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 transition-all group-hover:gap-2">
          Play now <span aria-hidden="true">→</span>
        </span>
      </a>
    </li>

    <li>
      <a href="/maze"
         class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 no-underline shadow-sm transition hover:-translate-y-0.5 hover:border-brand-500 hover:shadow-md">
        <div class="text-4xl">🌀</div>
        <div class="mt-3 text-xl font-bold text-slate-900">Mazes</div>
        <p class="mt-1 text-sm text-slate-500">Drag your finger from start to finish. Play on screen or print.</p>
        <div class="mt-4 flex items-center gap-2 text-xs font-medium text-slate-400">
          <span class="rounded-full bg-slate-100 px-2 py-0.5">{mazeCount} mazes</span>
          <span class="rounded-full bg-slate-100 px-2 py-0.5">Grades 1–{mazeGrades}</span>
        </div>
        <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 transition-all group-hover:gap-2">Play now <span aria-hidden="true">→</span></span>
      </a>
    </li>

    <li>
      <a href="/sudoku" class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 no-underline shadow-sm transition hover:-translate-y-0.5 hover:border-brand-500 hover:shadow-md">
        <div class="text-4xl">🔢</div>
        <div class="mt-3 text-xl font-bold text-slate-900">Sudoku</div>
        <p class="mt-1 text-sm text-slate-500">Fill the grid with 1–N. Tap to play, or print it out.</p>
        <div class="mt-4 flex items-center gap-2 text-xs font-medium text-slate-400">
          <span class="rounded-full bg-slate-100 px-2 py-0.5">{sudokuCount} puzzles</span>
          <span class="rounded-full bg-slate-100 px-2 py-0.5">Grades 1–{sudokuGrades}</span>
        </div>
        <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 transition-all group-hover:gap-2">Play now <span aria-hidden="true">→</span></span>
      </a>
    </li>
  </ul>
</Base>
