---
import { getCollection, getEntry } from "astro:content";
import WordSearch from "../../../components/WordSearch.astro";
import "../../../styles/global.css";
import "../../../styles/print.css";
export async function getStaticPaths() {
  const items = await getCollection("wordsearches");
  return items.map((s) => ({ params: { id: s.data.id } }));
}
const { id } = Astro.params;
const s = (await getEntry("wordsearches", id!))!.data;
const dirsHint = s.maxDirections > 4
  ? "Words can go across, down, diagonally — even backwards."
  : s.maxDirections > 2
    ? "Words can go across, down, and diagonally."
    : "Words can go across and down.";
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><title>Word Search {s.size}×{s.size}</title></head>
  <body class="bg-white p-6 text-slate-900">
    <p class="no-print mb-4 text-sm text-slate-500">
      <a href={`/word-search/${s.id}`} class="text-brand-600 no-underline hover:underline">← Back</a>
      · Print → Save as PDF · <a href={`/word-search/${s.id}/answer`} class="text-brand-600 no-underline hover:underline">Answer key →</a>
    </p>
    <h1 class="text-2xl font-extrabold">Word Search {s.size}×{s.size}</h1>
    <p class="mt-1 mb-4 text-slate-600">Find every word from the list. {dirsHint}</p>
    <WordSearch size={s.size} grid={s.grid} words={s.words} theme={s.theme} />
  </body>
</html>
