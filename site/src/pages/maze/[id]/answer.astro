---
import { getCollection, getEntry } from "astro:content";
import Maze from "../../../components/Maze.astro";
import "../../../styles/global.css";
import "../../../styles/print.css";
export async function getStaticPaths() {
  const mazes = await getCollection("mazes");
  return mazes.map((m) => ({ params: { id: m.data.id } }));
}
const { id } = Astro.params;
const m = (await getEntry("mazes", id!))!.data;
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><title>{m.title} — solution</title></head>
  <body class="bg-white p-6 text-slate-900">
    <p class="no-print mb-4 text-sm text-slate-500">
      <a href={`/maze/${m.id}`} class="text-brand-600 no-underline hover:underline">← Back</a>
      · Use your browser's Print → Save as PDF.
      · <a href={`/maze/${m.id}/print`} class="text-brand-600 no-underline hover:underline">Blank maze →</a>
    </p>
    <h1 class="text-2xl font-extrabold tracking-tight">Solution — {m.title}</h1>
    <Maze cols={m.cols} rows={m.rows} open={m.open} start={m.start} end={m.end} decoyStarts={m.decoyStarts} theme={m.theme}
          showSolution={true} solution={m.solution} />
  </body>
</html>
