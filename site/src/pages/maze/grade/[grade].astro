---
import Base from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";
export async function getStaticPaths() {
  const mazes = (await getCollection("mazes"));
  const grades = [...new Set(mazes.map((m) => m.data.difficulty))];
  return grades.map((g) => {
    const inGrade = mazes.filter((m) => m.data.difficulty === g)
      .sort((a, b) => (a.data.createdAt < b.data.createdAt ? 1 : -1));
    return { params: { grade: g }, props: { mazes: inGrade, label: inGrade[0]!.data.gradeLabel } };
  });
}
const { mazes, label } = Astro.props;
---
<Base title={`${label} — Mazes`}>
  <nav class="mb-4 text-sm text-slate-500">
    <a href="/" class="text-slate-500 no-underline hover:underline">All games</a>
    <span class="px-1">/</span>
    <a href="/maze" class="text-slate-500 no-underline hover:underline">Mazes</a>
    <span class="px-1">/</span>
    <span class="capitalize text-slate-700">{label}</span>
  </nav>
  <h1 class="text-3xl font-extrabold capitalize tracking-tight">{label}</h1>
  <p class="mt-2 text-slate-500">Pick a maze.</p>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {mazes.map((m) => (
      <li>
        <a href={`/maze/${m.data.id}`} class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-5 no-underline shadow-sm transition hover:-translate-y-0.5 hover:border-brand-400 hover:shadow-md">
          <span class="text-2xl">{m.data.theme.startIcon} {m.data.theme.endIcon}</span>
          <span class="mt-2 text-base font-bold text-slate-900">{m.data.title}</span>
          <span class="mt-1 text-sm text-slate-500">{m.data.themeBlurb}</span>
          <span class="mt-3 text-xs font-medium text-slate-400">{m.data.cols}×{m.data.rows} · #{m.data.seed}</span>
        </a>
      </li>
    ))}
  </ul>
</Base>
