---
import Base from "../../../layouts/Base.astro";
import GameHeader from "../../../components/GameHeader.astro";
import { loadArcadeGames, gameUrl } from "../../../lib/arcade";

export function getStaticPaths() {
  return loadArcadeGames().map((game) => ({
    params: { slug: game.slug },
    props: { game },
  }));
}

const { game } = Astro.props;
// The raw game lives at /arcade/<slug>/index.html (served from public/). This
// wrapper sits one segment deeper (/arcade/<slug>/play) so its build output
// never overwrites that file — see playUrl()/gameUrl() in lib/arcade.ts.
const src = gameUrl(game.slug);
---
<Base title={`${game.title} · Arcade`}>
  <GameHeader
    crumbs={[{ label: "Home", href: "/" }, { label: "Arcade", href: "/arcade" }, { label: game.title }]}
    title={`${game.emoji} ${game.title}`}
    blurb={game.description}
    showCheck={false}
    showClear={false}
  />

  <div class="mt-5">
    {/* The game runs in a sandboxed iframe so its code can't touch the site
        chrome. allow-same-origin is kept so games can use localStorage.
        allow-pointer-lock / pointer-lock added for reverse-zelda (needs
        mouse capture for camera look) — purely additive, existing games
        that don't request pointer lock are unaffected. */}
    <iframe
      id="game-frame"
      data-src={src}
      title={game.title}
      sandbox="allow-scripts allow-same-origin allow-pointer-lock"
      allow="fullscreen; autoplay; gamepad; pointer-lock"
      class="h-[78vh] w-full rounded-2xl border border-slate-200 bg-white shadow-sm"
      loading="lazy"
    ></iframe>
    <p class="mt-3 text-sm text-slate-400">
      Made by {game.author} ·
      <a href={src} target="_blank" rel="noopener" class="text-brand-600 hover:underline">Open fullscreen ↗</a>
    </p>
  </div>
  {/* Host-side metering: THIS page (not the game) owns the parent's time limit. The game only loads
      after the gate passes, the clock runs while it is on screen even if the game never calls the SDK,
      and the gate is re-raised over the frame when time runs out. */}
  <script is:inline src="/arcade/_sdk/marshellis.js"></script>
  <script is:inline define:vars={{ slug: game.slug }}>
    (function () {
      var frame = document.getElementById("game-frame");
      var mg = Marshellis.init({ game: slug, host: true, onLimit: function () { frame.src = "about:blank"; mg.gate().then(function (ok) { if (ok) frame.src = frame.dataset.src; }); } });
      // Fail open if the platform API is unreachable for 6s: a dead network cannot be metered anyway.
      setTimeout(function () { if (!frame.src || frame.src === "about:blank") frame.src = frame.dataset.src; }, 6000);
      mg.ready.then(function () { return mg.gate(); }).then(function (ok) {
        if (ok) frame.src = frame.dataset.src;
        else frame.insertAdjacentHTML("afterend", '<p class="mt-3 text-sm text-slate-500">That is all the play time for today. See you tomorrow!</p>');
      });
    })();
  </script>
</Base>
