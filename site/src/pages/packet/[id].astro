---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import GameHeader from "../../components/GameHeader.astro";
import MathPacket from "../../components/MathPacket.astro";

export async function getStaticPaths() {
  const packets = await getCollection("packets");
  return packets.map((p) => ({ params: { id: p.data.id } }));
}

const { id } = Astro.params;
const entry = await getEntry("packets", id!);
const packet = entry!.data;
---
<Base title={`${packet.title} — Math Worksheets`}>
  <GameHeader
    crumbs={[
      { label: "All games", href: "/" },
      { label: "Math Worksheets", href: "/math" },
      { label: packet.gradeLabel, href: `/math/grade/${packet.difficulty}` },
    ]}
    title={packet.title}
    blurb={packet.blurb}
    printHref={`/packet/${packet.id}/print`}
    answerHref={`/packet/${packet.id}/answer`}
    revealNoun="answers"
  />

  <div id="packet-root" class="mt-6">
    <MathPacket packet={packet} mode="play" />
  </div>

  <p class="mt-6 text-xs text-slate-400">Tip: tap a number to circle it, type answers in the boxes, and tap the symbol buttons (&lt; = &gt; or + − ×). Then hit Check!</p>

  <script>
    import { initPacket } from "../../games/math-packet/player.ts";
    const root = document.getElementById("packet-root") as HTMLElement;
    const { check, reveal, reset } = initPacket(root);
    document.getElementById("check")?.addEventListener("click", check);
    document.getElementById("clear")?.addEventListener("click", reset);
    document.getElementById("reveal")?.addEventListener("click", reveal);
  </script>
</Base>
