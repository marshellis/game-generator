---
import { getCollection, getEntry } from "astro:content";
import { keyForActivity } from "../../../games/math-packet/answers";
import "../../../styles/global.css";
import "../../../styles/print.css";

export async function getStaticPaths() {
  const packets = await getCollection("packets");
  return packets.map((p) => ({ params: { id: p.data.id } }));
}

const { id } = Astro.params;
const entry = await getEntry("packets", id!);
const packet = entry!.data;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{packet.title} — answer key</title>
  </head>
  <body class="bg-white p-6 text-slate-900">
    <p class="no-print mb-4 text-sm text-slate-500">
      <a href={`/packet/${packet.id}`} class="text-brand-600 no-underline hover:underline">← Back</a>
      · Use your browser's Print → Save as PDF.
      · <a href={`/packet/${packet.id}/print`} class="text-brand-600 no-underline hover:underline">Worksheet →</a>
    </p>

    <section class="answer-key">
      <h1 class="text-2xl font-extrabold tracking-tight">Answer Key</h1>
      <p class="mt-1 mb-4 text-slate-600">{packet.gradeLabel} · {packet.title}</p>
      <ol class="flex flex-col gap-2 text-sm">
        {packet.activities.map((act, ai) => (
          <li>
            <span class="font-semibold">{ai + 1}. {act.title}:</span>
            <span class="ml-1">{keyForActivity(act).join("  ·  ")}</span>
          </li>
        ))}
      </ol>
    </section>
  </body>
</html>
