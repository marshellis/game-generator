---
import Base from "../../layouts/Base.astro";
---
<Base title="Game Store — Marshellis Games" noindex>
  <h1 class="text-3xl font-extrabold tracking-tight">Game Store</h1>
  <p class="mt-2 text-slate-500">Games from other makers, reviewed by us. They run in a safe box and only see your nickname.</p>
  <div id="list" class="mt-6 grid gap-4 sm:grid-cols-2">Loading…</div>
  <script is:inline>
    (async function () {
      var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); };
      var el = document.getElementById("list");
      try {
        var j = await (await fetch("/api/family/store/games")).json();
        el.innerHTML = j.games.length ? j.games.map(function (g) {
          return '<a href="/store/' + encodeURIComponent(g.slug) + '" class="block rounded-xl border border-slate-200 bg-white p-4 no-underline hover:border-slate-400"><div class="font-bold text-slate-900">' + esc(g.title) + '</div><div class="mt-1 text-sm text-slate-600">' + esc(g.description) + '</div><div class="mt-2 text-xs text-slate-500">Ages ' + g.minAge + "+ · " + esc(g.categories.join(", ")) + "</div></a>";
        }).join("") : "<p class='text-slate-500'>No games yet.</p>";
      } catch (e) { el.textContent = "Could not load the store."; }
    })();
  </script>
</Base>
