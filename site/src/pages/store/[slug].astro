---
import Base from "../../layouts/Base.astro";
export const prerender = false;
const { slug } = Astro.params;
---
<Base title="Game Store — Marshellis Games" noindex>
  <nav class="mb-4 text-sm text-slate-500"><a href="/store" class="text-slate-500 no-underline hover:underline">Store</a></nav>
  <h1 id="t" class="text-2xl font-extrabold tracking-tight">Loading…</h1>
  <div id="mg-picker" class="mt-3"></div><div id="mg-chip" class="mt-3"></div>
  <div class="mt-4 overflow-hidden rounded-xl border border-slate-200 bg-black">
    <!-- No allow-same-origin: the outside game cannot touch our cookies, storage or accounts. -->
    <iframe id="g" sandbox="allow-scripts allow-pointer-lock" allow="fullscreen" class="block h-[70vh] w-full" title="game" referrerpolicy="no-referrer"></iframe>
  </div>
  <script is:inline src="/arcade/_sdk/marshellis.js"></script>
  <script is:inline src="/arcade/_sdk/host-bridge.js"></script>
  <script is:inline define:vars={{ slug }}>
    (async function () {
      var j = await (await fetch("/api/family/store/games")).json();
      var g = j.games.find(function (x) { return x.slug === slug; });
      if (!g) { document.getElementById("t").textContent = "Game not found"; return; }
      document.getElementById("t").textContent = g.title;
      var mg = Marshellis.init({ game: "store-" + slug, chip: "#mg-chip", picker: "#mg-picker" });
      var f = document.getElementById("g");
      HostBridge.attach(f, { game: slug, mg: mg });
      f.src = g.url;
    })();
  </script>
</Base>
