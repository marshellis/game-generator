---
import type { PuzzleData } from "../games/logic-grid/grid";
interface Props { puzzle: PuzzleData; interactive?: boolean; }
const { puzzle, interactive = false } = Astro.props;

// Standard logic-grid layout (triangular "staircase" matrix):
//  - columns (top axis):  categories 0 .. N-2, in order        (first category appears only on top)
//  - rows   (left axis):  categories N-1 .. 1, reversed         (last category appears only on the side)
//  - a block exists at (rowCat R, colCat C) only when C < R     (omit self + symmetric duplicates)
// Every item is cross-referenced against every item in another category exactly once.
const cats = puzzle.categories;
const N = cats.length;
const M = cats[0]!.items.length;
const colCats = Array.from({ length: N - 1 }, (_, i) => i);           // 0 .. N-2
const rowCats = Array.from({ length: N - 1 }, (_, i) => N - 1 - i);   // N-1 .. 1
---
<div class="logic-grid" data-interactive={interactive ? "1" : "0"}>
  <div class="grid-scroll">
    <table class="lg">
      <thead>
        <tr>
          <th class="corner" colspan="2" rowspan="2"></th>
          {colCats.map((c) => <th class="cat-top" colspan={M}>{cats[c]!.name}</th>)}
        </tr>
        <tr>
          {colCats.map((c) =>
            cats[c]!.items.map((it, ci) => (
              <th class={`item-top${ci === 0 ? " block-edge-left" : ""}`}><span>{it}</span></th>
            )),
          )}
        </tr>
      </thead>
      <tbody>
        {rowCats.map((R) =>
          cats[R]!.items.map((rit, ri) => (
            <tr class={ri === 0 ? "block-edge-top" : ""}>
              {ri === 0 && <th class="cat-left" rowspan={M}><span>{cats[R]!.name}</span></th>}
              <th class="item-left">{rit}</th>
              {colCats.map((C) => {
                if (C < R) {
                  return cats[C]!.items.map((_, ci) => (
                    <td
                      class={`cell${ci === 0 ? " block-edge-left" : ""}${ri === 0 ? " block-edge-top" : ""}`}
                      data-a={C} data-ai={ci} data-b={R} data-bi={ri}
                    ></td>
                  ));
                }
                if (C === R && ri === 0) {
                  return <td class="blank" colspan={(N - 1 - R) * M} rowspan={M}></td>;
                }
                return null;
              })}
            </tr>
          )),
        )}
      </tbody>
    </table>
  </div>
  <ol class="clues">
    {puzzle.clues.map((c) => <li>{c.text}</li>)}
  </ol>
</div>

<style>
  .logic-grid { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
  .grid-scroll { overflow-x: auto; max-width: 100%; }

  table.lg { border-collapse: collapse; }
  table.lg th, table.lg td { border: 1px solid #cbd5e1; }

  /* category labels */
  th.corner { background: #fff; border: none; }
  th.cat-top { background: #1e293b; color: #fff; font-size: 12px; font-weight: 700;
               padding: 6px 4px; letter-spacing: .02em; }
  th.cat-left { background: #1e293b; color: #fff; font-size: 12px; font-weight: 700; }
  th.cat-left span { writing-mode: vertical-rl; transform: rotate(180deg); display: inline-block;
                     padding: 4px 2px; white-space: nowrap; }

  /* item labels */
  th.item-top { background: #f1f5f9; height: 96px; vertical-align: bottom; padding: 4px 0; }
  th.item-top span { writing-mode: vertical-rl; transform: rotate(180deg); display: inline-block;
                     font-size: 12px; font-weight: 600; white-space: nowrap; }
  th.item-left { background: #f1f5f9; font-size: 12px; font-weight: 600; text-align: right;
                 padding: 4px 8px; white-space: nowrap; }

  /* cells */
  td.cell { width: 30px; height: 30px; min-width: 30px; cursor: pointer; text-align: center;
            font-weight: 700; font-size: 17px; line-height: 1; user-select: none; background: #fff; }
  td.cell[data-mark="x"] { color: #dc2626; }
  td.cell[data-mark="o"] { color: #2563eb; }
  td.blank { background: #f8fafc; border: 1px solid #cbd5e1; }

  /* heavier separators between category blocks */
  th.block-edge-left, td.cell.block-edge-left { border-left: 2px solid #1e293b; }
  td.cell.block-edge-top { border-top: 2px solid #1e293b; }
  tr.block-edge-top th.item-left { border-top: 2px solid #1e293b; }

  .clues { min-width: 260px; max-width: 420px; flex: 1; }
  .clues li { margin-bottom: 6px; }
  @media (max-width: 640px) { .logic-grid { gap: 16px; } }
</style>
